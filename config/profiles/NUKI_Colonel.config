# KernelX Profile - NUKI Colonel
# AnyRealm Unified Kernel Image, Colonel variant
# Target: Motorola Moto G Stylus 5G 2023 (SM6450 parrot)
# All paths reference GitHub repos for CI execution
# Cross-referenced: kernel-msm-1 (ANYREALM_MATRIX + KPM_SUKI_ULTRA + COLONEL_PB)
# Cross-referenced: Super-Builders (build workflows)
# Cross-referenced: KernelSU-Next (KPM source)

# =============================================================================
# REPOS (all cross-referenced for redundancy)
# =============================================================================
REPO_KERNEL=https://github.com/015stray91/kernel-msm-1
REPO_KERNEL_BRANCH=android-14-release-u1tgns34.42-86-2-32
REPO_SUPER_BUILDERS=https://github.com/015stray91/Super-Builders
REPO_SUPER_BUILDERS_BRANCH=015stray91
REPO_KERNELX=https://github.com/015stray91/Kernel-1
REPO_KERNELX_BRANCH=main
REPO_KSU_NEXT=https://github.com/015stray91/KernelSU-Next
REPO_KSU_NEXT_BRANCH=android-14-release-u1tgns34.42-86-2-32

# =============================================================================
# KERNEL
# =============================================================================
KERNEL_NAME=NUKI Colonel
KERNEL_VERSION=2.0.0
KERNEL_SOURCE_URL=https://github.com/015stray91/kernel-msm-1
KERNEL_BRANCH=android-14-release-u1tgns34.42-86-2-32
KERNEL_SOURCE_DIR=kernel-source
BUILD_ARCH=arm64
BUILD_CROSS_COMPILE=aarch64-linux-gnu-
BUILD_OUTPUT_DIR=output

# =============================================================================
# BUILD
# =============================================================================
ADVANCED_CUSTOM_DEFCONFIG=ksu-nh.defconfig
ADVANCED_EXTRA_CFLAGS=-DCONFIG_KERNEL_LZ4=y

# =============================================================================
# ANYREALM MATRIX (5 styles x 3 tiers = 15 KPM variants)
# Source: kernel-msm-1/fs/koto/
# flags=logic | .c/.h=movement | diff=proof-of-concept | patch=seal
# =============================================================================
ANYREALM_STYLES="hiddnobj infusdobj outoftree upstrm unified"
ANYREALM_TIERS="test-load install embed"
ANYREALM_BUILTINS="Virtualspace hidden-objects kpm_eud_engine koto_core colonel_patch_builder"
ANYREALM_PATCHES=patches/anyrealm-matrix
ANYREALM_SERIES=patches/anyrealm-matrix/series

# =============================================================================
# KPM SUKI ULTRA (Kernel Patch Manager - Suki Ultra variant)
# Kernel-side:  kernel-msm-1/fs/koto/colonel_patch_builder.c
# Userland:    kernel-msm-1/tools/kpm/bin/{kpatch,kpimg,kptools,magiskboot}
# Deploy:      /data/adb/modules/KPatch-Next
# Device:      192.168.12.250:5555
# KPM ver:     d05 (confirmed: hello2026 on device)
# EUD device:  /dev/eud (USB Endpoint, colonel-pb bridge)
# FUSE binary: invisible to kernel, talks to /dev/colonel-pb via ioctl
# =============================================================================
KPM_VERSION=d05
KPM_KERNEL_MODULE=fs/koto/colonel_patch_builder.c
KPM_BINARIES=tools/kpm/bin
KPM_WRAPPER=tools/kpm/scripts/colonel-pb
KPM_DEPLOY_PATH=/data/adb/modules/KPatch-Next
KPM_DEVICE_ID=192.168.12.250:5555
KPM_HELLO_VERIFIED=$(adb -s 192.168.12.250:5555 shell /data/adb/modules/KPatch-Next/bin/kpatch hello)
KPM_EUD_DEVICE=/dev/eud
KPM_KPROBES_VERIFIED=CONFIG_KPROBES=y
KPM_FUSE_VERIFIED=CONFIG_FUSE_FS=y

# =============================================================================
# COLONEL PATCH BUILDER (orchestration layer)
# wraps kpatch kpm load/unload/list/info
# reads patches/anyrealm-matrix/{test-load,install,embed}/*.patch in tier order
# applies seal via /dev/colonel-pb ioctl
# =============================================================================
COLONEL_PB=tools/kpm/scripts/colonel-pb
COLONEL_PB_COMMANDS="load unload list info status deploy hello"

# =============================================================================
# DEVICE
# =============================================================================
DEVICE_NAME=parrot
DEVICE_CODE=parrot
DEVICE_PLATFORM=qcom
DEVICE_FAMILY=motorola
DEVICE_ANDROID_VERSION=14
DEVICE_API_LEVEL=34
DEVICE_KERNEL_VERSION=5.10.218
DEVICE_ADB=192.168.12.250:5555
DEVICE_COMPATIBLE=true
DEVICE_IDENTIFIED=true

# =============================================================================
# ACTIVE FLAGS (pulled from /proc/config.gz on device)
# arch/arm64/configs/colonel_active_flags.txt
# arch/arm64/configs/active_running.config
# =============================================================================
ACTIVE_FLAGS_FILE=arch/arm64/configs/colonel_active_flags.txt
ACTIVE_KERNEL_CONFIG=arch/arm64/configs/active_running.config
ACTIVE_KPM_VERIFIED=true
ACTIVE_EUD_VERIFIED=true
ACTIVE_FUSE_VERIFIED=true
ACTIVE_KPROBES_VERIFIED=true

# =============================================================================
# RAMDISK / IMAGE
# =============================================================================
RAMDISK_COMPRESSION=lz4
RAMDISK_FORMAT=cpio
KERNEL_IMAGE=Image.gz

# =============================================================================
# SAFETY
# =============================================================================
SAFETY_BACKUP_BEFORE_PATCH=true
SAFETY_VERIFY_BUILD=true
SAFETY_DRY_RUN_DEFAULT=false
SAFETY_ADB_POOL_CHECK=true

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=kernelx.log
