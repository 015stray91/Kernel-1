# KernelX Configuration - NUKI Colonel / AnyRealm
# Device: Motorola Moto G Stylus 5G 2023 (SM6450 parrot)
# Generated: 2026-09-04
# Execution: Remote (all paths reference GitHub repos, not local dirs)

# =============================================================================
# REPO URLs (all local paths have remote equivalents for CI)
# =============================================================================

REPO_KERNEL=https://github.com/015stray91/kernel-msm-1
REPO_KERNEL_BRANCH=android-14-release-u1tgns34.42-86-2-32

REPO_KERNELX=https://github.com/015stray91/Kernel-1
REPO_KERNELX_BRANCH=main

REPO_SUPER_BUILDERS=https://github.com/015stray91/Super-Builders
REPO_SUPER_BUILDERS_BRANCH=015stray91

REPO_TOOLCHAIN=https://github.com/015stray91/android-kernel-tools
REPO_TOOLCHAIN_BRANCH=tools

REPO_CLANG_STATIC=https://github.com/015stray91/clang-tools-static-binaries
REPO_CLANG_STATIC_BRANCH=master

# Kotoamatsukami - LLVM-17 obfuscator (defense layer, scanner blocker)
# NOT used in direct build - referenced only, acts as passive defense
REPO_KOTOAMATSUKAMI=https://github.com/015stray91/Kotoamatsukami
REPO_KOTOAMATSUKAMI_BRANCH=llvm-17-plugins

# =============================================================================
# KERNEL SETTINGS
# =============================================================================
KERNEL_NAME=NUKI Colonel
KERNEL_VERSION=2.0.0
KERNEL_SOURCE_URL=https://github.com/015stray91/kernel-msm-1
KERNEL_SOURCE_DIR=
KERNEL_BRANCH=android-14-release-u1tgns34.42-86-2-32

# =============================================================================
# BUILD SETTINGS
# =============================================================================
BUILD_ARCH=arm64
BUILD_CROSS_COMPILE=aarch64-linux-gnu-
BUILD_JOBS=$(nproc)
BUILD_OUTPUT_DIR=output

# =============================================================================
# TOOLCHAIN (mirrors local tools/toolchains/snapdragon-toolchain)
# =============================================================================
BUILD_TOOLCHAIN_PATH=/usr/bin

# AOSP Clang 12 (clang-r416183b)
TOOLCHAIN_CLANG_URL=https://github.com/015stray91/android-kernel-tools
TOOLCHAIN_CLANG_BRANCH=tools
TOOLCHAIN_CLANG_SUBDIR=clang/host/linux-x86
TOOLCHAIN_CLANG_BIN=clang/host/linux-x86/clang-r416183b/bin

# Snapdragon Clang 8.0.6
TOOLCHAIN_SDCLANG_URL=https://github.com/015stray91/android-kernel-tools
TOOLCHAIN_SDCLANG_BRANCH=tools
TOOLCHAIN_SDCLANG_SUBDIR=sdclang/linux-x86_64
TOOLCHAIN_SDCLANG_BIN=sdclang/linux-x86_64/bin

# Linaro GCC 7.5.0 aarch64
TOOLCHAIN_GCC_URL=https://github.com/015stray91/android-kernel-tools
TOOLCHAIN_GCC_BRANCH=tools
TOOLCHAIN_GCC_SUBDIR=gcc/linux-x86/aarch64/gcc-linaro-7.5.0
TOOLCHAIN_GCC_BIN=gcc/linux-x86/aarch64/gcc-linaro-7.5.0/aarch64-linux-gnu/bin

# Static clang tools (llvm-ar, llvm-nm, llvm-objcopy, etc.)
TOOLCHAIN_LLVM_FULL_URL=https://github.com/015stray91/clang-tools-static-binaries
TOOLCHAIN_LLVM_FULL_BRANCH=master

TOOLCHAIN_VERSION=clang-r416183b
TOOLCHAIN_LLVM=12
TOOLCHAIN_GCC_LINARO=7.5.0
TOOLCHAIN_SDCLANG_VER=8.0.6

# =============================================================================
# DEVICE SETTINGS (from wireless ADB: 192.168.12.250:5555)
# =============================================================================
DEVICE_NAME=parrot
DEVICE_ARCH=arm64
DEVICE_PLATFORM=qcom
DEVICE_ID=192.168.12.250:5555
DEVICE_MODEL=moto g stylus 5G - 2023
DEVICE_BRAND=motorola
DEVICE_CODE=parrot
DEVICE_ANDROID_VERSION=14
DEVICE_API_LEVEL=34
DEVICE_KERNEL_VERSION=5.10.218-android12-9-00057-g5659b677bceb-ab12885890
DEVICE_FAMILY=motorola
DEVICE_IDENTIFIED=true
DEVICE_COMPATIBLE=true

# =============================================================================
# RAMDISK SETTINGS
# =============================================================================
RAMDISK_PATH=
RAMDISK_COMPRESSION=lz4
RAMDISK_FORMAT=cpio

# =============================================================================
# PATCH SETTINGS
# =============================================================================
PATCH_DIR=patches
PATCH_FORMAT=diff
PATCH_BACKUP_ORIG=true

# =============================================================================
# SAFETY SETTINGS
# =============================================================================
SAFETY_BACKUP_BEFORE_PATCH=true
SAFETY_VERIFY_BUILD=true
SAFETY_DRY_RUN_DEFAULT=false

# =============================================================================
# LOGGING SETTINGS
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=kernelx.log
LOG_MAX_SIZE=10MB

# =============================================================================
# ADVANCED SETTINGS
# =============================================================================
ADVANCED_CUSTOM_MAKEFILE=
ADVANCED_CUSTOM_DEFCONFIG=ksu-nh.defconfig
ADVANCED_EXTRA_CFLAGS=-DCONFIG_KERNEL_LZ4=y

# =============================================================================
# PROFILE
# =============================================================================
KERNELX_PROFILE=parrot
