# KernelX Configuration - NUKI Colonel / AnyRealm
# Device: Motorola Moto G Stylus 5G 2023 (SM6450 parrot)
# Generated: 2026-09-04
# Execution: Remote (all paths reference GitHub repos, not local dirs)

# =============================================================================
# REPO URLs (all local paths have remote equivalents for CI)
# All repos MUST reflect each other - cross-referenced for redundancy.
# If you change a branch here, update it in the others too.
# =============================================================================

# Primary kernel source
REPO_KERNEL=https://github.com/015stray91/kernel-msm-1
REPO_KERNEL_BRANCH=android-14-release-u1tgns34.42-86-2-32

# This tool (KernelX kitchen) - cross-referenced
REPO_KERNELX=https://github.com/015stray91/Kernel-1
REPO_KERNELX_BRANCH=main

# Super-Builders - cross-referenced (NUKI Colonel workflows live here)
REPO_SUPER_BUILDERS=https://github.com/015stray91/Super-Builders
REPO_SUPER_BUILDERS_BRANCH=015stray91

# KernelSU-Next (KPM Suki Ultra fork) - cross-referenced
REPO_KSU_NEXT=https://github.com/015stray91/KernelSU-Next
REPO_KSU_NEXT_BRANCH=android-14-release-u1tgns34.42-86-2-32

# Kotoamatsukami - LLVM-17 obfuscator (defense layer, scanner blocker)
# OUTSIDE WRAPPER, NOT IN THE COLONEL BUILD PIPELINE
# Role: external defense layer / scanner blocker
# Status: referenced only - not compiled into the kernel, not invoked by
#         any build step. Acts as a passive decoy/cover so scanners
#         that probe the build environment see obfuscation artifacts
#         without affecting the actual Colonel build output.
REPO_KOTOAMATSUKAMI=https://github.com/015stray91/Kotoamatsukami
REPO_KOTOAMATSUKAMI_BRANCH=llvm-17-plugins
KOTOAMATSUKAMI_ROLE=outside_wrapper_defense
KOTOAMATSUKAMI_IN_BUILD=false

# =============================================================================
# ANYREALM MATRIX + KPM SUKI ULTRA + COLONEL PATCH BUILDER
# All three are integrated into REPO_KERNEL above. The matrix is in
# fs/koto/, the KPM binaries in tools/kpm/, and the patches in
# patches/anyrealm-matrix/. Everything is referenced through the
# kernel-msm-1 repo, so this section only adds labels for the kitchen.
# =============================================================================

# AnyRealm Matrix (5 styles x 3 tiers = 15 kernel module variants)
#   styles:  hiddnobj, infusdobj, outoftree, upstrm, unified
#   tiers:   test-load, install, embed
# Lives at: kernel-msm-1/fs/koto/
ANYREALM_MATRIX_PATH=fs/koto
ANYREALM_MATRIX_BUILTINS="Virtualspace hidden-objects kpm_eud_engine koto_core colonel_patch_builder"
ANYREALM_MATRIX_VARIANTS="hiddnobj infusdobj outoftree upstrm unified"

# KPM Suki Ultra (Kernel Patch Manager - Suki Ultra variant of KSU-Next)
#   Kernel-side:  fs/koto/colonel_patch_builder.c  (creates /dev/colonel-pb)
#   Userland:     tools/kpm/bin/{kpatch,kpimg,kptools,magiskboot}
#   Wrapper:      tools/kpm/scripts/colonel-pb
KPM_SUKI_ULTRA_VERSION=d05
KPM_SUKI_ULTRA_KERNEL_MODULE=fs/koto/colonel_patch_builder.c
KPM_SUKI_ULTRA_BINARIES=tools/kpm/bin
KPM_SUKI_ULTRA_WRAPPER=tools/kpm/scripts/colonel-pb
KPM_SUKI_ULTRA_DEPLOY_PATH=/data/adb/modules/KPatch-Next
KPM_DEVICE_ACTIVE=$(adb -s 192.168.12.250:5555 shell /data/adb/modules/KPatch-Next/bin/kpatch hello 2>/dev/null)

# Colonel Patch Builder (the orchestration tool, wraps kpatch)
COLONEL_PATCH_BUILDER_PATH=tools/kpm/scripts/colonel-pb
COLONEL_PATCH_BUILDER_PATCHES=patches/anyrealm-matrix
COLONEL_PATCH_BUILDER_SERIES=patches/anyrealm-matrix/series

# =============================================================================
# KERNEL SETTINGS
# =============================================================================
KERNEL_NAME=NUKI Colonel
KERNEL_VERSION=2.0.0
KERNEL_SOURCE_URL=https://github.com/015stray91/kernel-msm-1
KERNEL_SOURCE_DIR=
KERNEL_BRANCH=android-14-release-u1tgns34.42-86-2-32

# =============================================================================
# BUILD SETTINGS
# =============================================================================
BUILD_ARCH=arm64
BUILD_CROSS_COMPILE=aarch64-linux-gnu-
BUILD_JOBS=$(nproc)
BUILD_OUTPUT_DIR=output

# =============================================================================
# TOOLCHAIN (mirrors local tools/toolchains/snapdragon-toolchain)
# =============================================================================
BUILD_TOOLCHAIN_PATH=/usr/bin

# AOSP Clang 12 (clang-r416183b)
TOOLCHAIN_CLANG_URL=https://github.com/015stray91/android-kernel-tools
TOOLCHAIN_CLANG_BRANCH=tools
TOOLCHAIN_CLANG_SUBDIR=clang/host/linux-x86
TOOLCHAIN_CLANG_BIN=clang/host/linux-x86/clang-r416183b/bin

# Snapdragon Clang 8.0.6
TOOLCHAIN_SDCLANG_URL=https://github.com/015stray91/android-kernel-tools
TOOLCHAIN_SDCLANG_BRANCH=tools
TOOLCHAIN_SDCLANG_SUBDIR=sdclang/linux-x86_64
TOOLCHAIN_SDCLANG_BIN=sdclang/linux-x86_64/bin

# Linaro GCC 7.5.0 aarch64
TOOLCHAIN_GCC_URL=https://github.com/015stray91/android-kernel-tools
TOOLCHAIN_GCC_BRANCH=tools
TOOLCHAIN_GCC_SUBDIR=gcc/linux-x86/aarch64/gcc-linaro-7.5.0
TOOLCHAIN_GCC_BIN=gcc/linux-x86/aarch64/gcc-linaro-7.5.0/aarch64-linux-gnu/bin

# Static clang tools (llvm-ar, llvm-nm, llvm-objcopy, etc.)
TOOLCHAIN_LLVM_FULL_URL=https://github.com/015stray91/clang-tools-static-binaries
TOOLCHAIN_LLVM_FULL_BRANCH=master

TOOLCHAIN_VERSION=clang-r416183b
TOOLCHAIN_LLVM=12
TOOLCHAIN_GCC_LINARO=7.5.0
TOOLCHAIN_SDCLANG_VER=8.0.6

# =============================================================================
# DEVICE SETTINGS (from wireless ADB: 192.168.12.250:5555)
# =============================================================================
DEVICE_NAME=parrot
DEVICE_ARCH=arm64
DEVICE_PLATFORM=qcom
DEVICE_ID=192.168.12.250:5555
DEVICE_MODEL=moto g stylus 5G - 2023
DEVICE_BRAND=motorola
DEVICE_CODE=parrot
DEVICE_ANDROID_VERSION=14
DEVICE_API_LEVEL=34
DEVICE_KERNEL_VERSION=5.10.218-android12-9-00057-g5659b677bceb-ab12885890
DEVICE_FAMILY=motorola
DEVICE_IDENTIFIED=true
DEVICE_COMPATIBLE=true

# =============================================================================
# RAMDISK SETTINGS
# =============================================================================
RAMDISK_PATH=
RAMDISK_COMPRESSION=lz4
RAMDISK_FORMAT=cpio

# =============================================================================
# PATCH SETTINGS
# =============================================================================
PATCH_DIR=patches
PATCH_FORMAT=diff
PATCH_BACKUP_ORIG=true

# =============================================================================
# SAFETY SETTINGS
# =============================================================================
SAFETY_BACKUP_BEFORE_PATCH=true
SAFETY_VERIFY_BUILD=true
SAFETY_DRY_RUN_DEFAULT=false

# =============================================================================
# LOGGING SETTINGS
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=kernelx.log
LOG_MAX_SIZE=10MB

# =============================================================================
# ADVANCED SETTINGS
# =============================================================================
ADVANCED_CUSTOM_MAKEFILE=
ADVANCED_CUSTOM_DEFCONFIG=ksu-nh.defconfig
ADVANCED_EXTRA_CFLAGS=-DCONFIG_KERNEL_LZ4=y

# =============================================================================
# PROFILE
# =============================================================================
KERNELX_PROFILE=parrot
