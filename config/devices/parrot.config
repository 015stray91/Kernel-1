# KernelX Device Config - Motorola Moto G Stylus 5G 2023 (SM6450 parrot)
# AnyRealm NUKI Colonel target

# Device Identification
DEVICE_NAME=parrot
DEVICE_CODE=parrot
DEVICE_FAMILY=motorola
DEVICE_PLATFORM=qcom
DEVICE_IDENTIFIED=false
DEVICE_COMPATIBLE=true

# Architecture
BUILD_ARCH=arm64
DEVICE_ARCH=arm64

# Cross-Compile
BUILD_CROSS_COMPILE=aarch64-linux-gnu-

# Kernel Defconfig
ADVANCED_CUSTOM_DEFCONFIG=ksu-nh.defconfig

# Ramdisk
RAMDISK_COMPRESSION=lz4

# Kernel Compression (NUKI Colonel uses Image.lz4)
ADVANCED_EXTRA_CFLAGS=-DCONFIG_KERNEL_LZ4=y

# Build Hygiene
SAFETY_BACKUP_BEFORE_PATCH=true
SAFETY_VERIFY_BUILD=true
