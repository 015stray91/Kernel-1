# KernelX gitignore

# Runtime / temp directories (created at runtime)
temp/
plugins/enabled/*
!plugins/enabled/.gitkeep
temp/patches/*
!temp/patches/.gitkeep

# Build output
output/
*.img
*.ko
*.dtb
*.dtbo
build.log

# Local configs (only keep default.config and profiles in version control)
# (intentionally NOT ignoring config/default.config, config/devices/, config/profiles/)
config/local.config

# Backup files
*.bak
*.orig
*.rej

# OS junk
.DS_Store
Thumbs.db

# Editor junk
*.swp
*.swo
*~
.vscode/
.idea/

# Logs
*.log
logs/
